diff --git a/boards/px4/fmu-v6x/init/rc.board_defaults b/boards/px4/fmu-v6x/init/rc.board_defaults
index 7dfe7b546a..89134dd507 100644
--- a/boards/px4/fmu-v6x/init/rc.board_defaults
+++ b/boards/px4/fmu-v6x/init/rc.board_defaults
@@ -3,6 +3,16 @@
 # board specific defaults
 #------------------------------------------------------------------------------
 
+# Renode/SIH testing (specs/004-sih-renode-mavlink.md): force the quad-X
+# SIH airframe (1100_rc_quad_x_sih.hil, which itself sets SYS_HITL=2 and
+# the rest of the SIH-specific parameters) every boot. There is no
+# persistent parameter storage in this environment (Renode does not
+# model fmu-v6x's FRAM/MTD chip), so a plain `param set SYS_AUTOSTART
+# 1100` from an interactive shell would not survive a reboot -- setting
+# it here in rc.board_defaults (which runs before rcS's airframe-
+# selection step) makes it the effective default on every boot instead.
+param set SYS_AUTOSTART 1100
+
 # By disabling all 3 INA modules, we use the
 # i2c_launcher instead.
 param set-default SENS_EN_INA238 0
